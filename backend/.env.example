# Copy this file to .env and fill in real values. .env is gitignored.

SECRET_KEY=change-me-to-a-long-random-string

# Leave DATABASE_URL empty to use a local SQLite file (instance/hotelease.db).
# For the AWS RDS PostgreSQL instance, use:
#   DATABASE_URL=postgresql://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/hotelease
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API (credentialed
# CORS). "*" is NOT honoured -- it cannot be combined with cookies and would let
# any site call the API with a staff session. Production is same-origin (nginx
# serves the frontend and /api together) so no value is needed there; set this
# only for a cross-origin dev setup, e.g. CORS_ORIGINS=http://localhost:8080
CORS_ORIGINS=

# Set to 1 ONLY once the site is served over HTTPS. It marks the session cookie
# Secure (HTTPS-only). Leaving it at 0 over plain HTTP keeps login working.
SESSION_COOKIE_SECURE=0

# S3 object storage for guest ID-document uploads.
# The bucket is private; credentials come from the EC2 instance role, so no
# access keys are set here. On the server these usually keep the defaults.
S3_BUCKET=hotelease-uploads
AWS_REGION=eu-west-1
